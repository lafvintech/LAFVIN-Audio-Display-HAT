{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lafvin.dev/schemas/app-manifest-v1.schema.json",
  "title": "LAFVIN HAT App Manifest V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "version",
    "entrypoint",
    "permissions",
    "ui",
    "lifecycle"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "entrypoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executable", "args"],
      "properties": {
        "executable": {
          "type": "string",
          "minLength": 1
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "working_directory": {
          "type": "string"
        }
      }
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "display.declarative",
          "display.raw_frame",
          "button",
          "led",
          "backlight",
          "microphone",
          "speaker",
          "network",
          "ai"
        ]
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {
          "enum": ["declarative", "raw_frame"]
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "startup_timeout_sec",
        "exit_timeout_sec",
        "restart",
        "max_restarts"
      ],
      "properties": {
        "startup_timeout_sec": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120
        },
        "exit_timeout_sec": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "restart": {
          "enum": ["never", "on-failure"]
        },
        "max_restarts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "ui": {
            "properties": {
              "mode": {
                "const": "declarative"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "permissions": {
            "contains": {
              "const": "display.declarative"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "ui": {
            "properties": {
              "mode": {
                "const": "raw_frame"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "permissions": {
            "contains": {
              "const": "display.raw_frame"
            }
          }
        }
      }
    }
  ]
}
