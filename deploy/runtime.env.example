# Hardware
LAFVIN_AUDIO_CARD=wm8960soundcard

# UI
# The bundled HarmonyOS Sans SC font is the default. Set absolute or
# project-relative paths only to override it deliberately.
# LAFVIN_UI_FONT=/path/to/custom-font.ttf
# LAFVIN_UI_FONT_BOLD=/path/to/custom-bold-font.ttf

# Media
# LAFVIN_VIDEO_AUDIO=1

# Select ASR, LLM, and TTS independently. These three settings are required.
# Supported names:
# - ASR: openai, fish
# - LLM: openai, deepseek, kimi, claude, openai-compatible
# - TTS: openai, minimax, fish
# Use fake only for explicit tests.
LAFVIN_ASR_PROVIDER=openai
LAFVIN_LLM_PROVIDER=openai
LAFVIN_TTS_PROVIDER=openai

# Provider settings may coexist. Only the selected ASR, LLM, and TTS Provider
# sections are read and validated.

# OpenAI: ASR, LLM, and TTS
OPENAI_API_KEY=
OPENAI_ASR_MODEL=whisper-1
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy

# Fish Audio: ASR and TTS
# Fish Audio ASR uses paid API credit and supports automatic language detection.
FISH_AUDIO_API_KEY=
FISH_AUDIO_ASR_MODEL=transcribe-1
# Leave blank for automatic language detection.(Optional)
FISH_AUDIO_ASR_LANGUAGE=
FISH_AUDIO_TTS_MODEL=s2.1-pro-free
# Optional Fish Audio voice reference ID; blank uses the service default.
FISH_AUDIO_TTS_VOICE=933563129e564b19a115bedd57b7406a
FISH_AUDIO_TTS_LATENCY=balanced

# DeepSeek: LLM
DEEPSEEK_API_KEY=
DEEPSEEK_LLM_MODEL=deepseek-v4-flash

# Kimi / Moonshot AI: LLM
MOONSHOT_API_KEY=
MOONSHOT_LLM_MODEL=kimi-k3

# Claude / Anthropic: LLM
ANTHROPIC_API_KEY=
ANTHROPIC_LLM_MODEL=
ANTHROPIC_LLM_MAX_TOKENS=1024
ANTHROPIC_VERSION=2023-06-01

# MiniMax: TTS
MINIMAX_API_KEY=
MINIMAX_TTS_MODEL=speech-2.8-turbo
MINIMAX_TTS_VOICE=male-qn-qingse

# Custom OpenAI-compatible LLM only. All three values are required when
# LAFVIN_LLM_PROVIDER=openai-compatible. Custom ASR/TTS endpoints are unsupported.
LAFVIN_OPENAI_COMPATIBLE_LLM_BASE_URL=
LAFVIN_OPENAI_COMPATIBLE_LLM_API_KEY=
LAFVIN_OPENAI_COMPATIBLE_LLM_MODEL=

# Chatbot device tools are enabled by default. Set to 0 to prevent the LLM
# from reading selected device status or changing volume and the RGB light.
LAFVIN_CHATBOT_TOOLS_ENABLED=1

# Diagnostics and transient network retries
# LAFVIN_AI_LOG_LEVEL=INFO
# Opt in only while debugging. Logs full LLM replies and the cleaned text sent
# to TTS, which may contain private conversation content.
# Set to 1 to include content in `lafvin-hat app run apps/chatbot --follow`.
LAFVIN_AI_LOG_CONTENT=0
# LAFVIN_AI_TIMEOUT_SEC=60
# LAFVIN_AI_RETRIES=2
# Capability-specific values override the global timeout and retry settings.
# LAFVIN_ASR_TIMEOUT_SEC=60
# LAFVIN_LLM_TIMEOUT_SEC=60
# LAFVIN_TTS_TIMEOUT_SEC=60
# LAFVIN_ASR_RETRIES=2
# LAFVIN_LLM_RETRIES=2
# LAFVIN_TTS_RETRIES=2

# Optional outbound HTTP proxy
# Leave these commented when the providers are reachable directly. A deployed
# systemd Runtime does not inherit proxy variables exported in your shell.
# For a Clash HTTP/Mixed port, set HTTP_PROXY and HTTPS_PROXY to the proxy's
# LAN address. Keep loopback traffic out of the proxy for local services.
# HTTP_PROXY=http://192.168.1.10:7890
# HTTPS_PROXY=http://192.168.1.10:7890
# ALL_PROXY=http://192.168.1.10:7890
# NO_PROXY=127.0.0.1,localhost,::1

# Optional translator setting
# LAFVIN_TRANSLATOR_TARGET_LANGUAGE=Chinese
