# Hardware
LAFVIN_AUDIO_CARD=wm8960soundcard

# UI
# The bundled HarmonyOS Sans SC font is the default. Set absolute or
# project-relative paths only to override it deliberately.
# LAFVIN_UI_FONT=/path/to/custom-font.ttf
# LAFVIN_UI_FONT_BOLD=/path/to/custom-bold-font.ttf

# Media
# LAFVIN_VIDEO_AUDIO=1

# Select ASR, LLM, and TTS independently. These three settings are required.
# Supported names:
# - ASR: openai, fish
# - LLM: openai, deepseek, kimi, claude, openai-compatible
# - TTS: openai, minimax, fish
# Use fake only for explicit tests.
LAFVIN_ASR_PROVIDER=openai
LAFVIN_LLM_PROVIDER=openai
LAFVIN_TTS_PROVIDER=openai

# OpenAI is active for all three capabilities above.
OPENAI_API_KEY=
LAFVIN_ASR_MODEL=whisper-1
LAFVIN_LLM_MODEL=gpt-4o-mini
LAFVIN_TTS_MODEL=tts-1
LAFVIN_TTS_VOICE=alloy

# Alternative ASR provider
# Set LAFVIN_ASR_PROVIDER above to fish.
# Fish Audio ASR uses paid API credit and supports automatic language detection.
# FISH_AUDIO_API_KEY=
# LAFVIN_ASR_MODEL=transcribe-1
# LAFVIN_ASR_LANGUAGE=zh

# Alternative LLM providers
# Change LAFVIN_LLM_PROVIDER above, uncomment the selected provider's API key,
# and replace LAFVIN_LLM_MODEL above with a supported model name.

# DeepSeek: LAFVIN_LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=
# LAFVIN_LLM_MODEL=your-deepseek-model

# Kimi: LAFVIN_LLM_PROVIDER=kimi
# MOONSHOT_API_KEY=
# LAFVIN_LLM_MODEL=kimi-k3

# Claude: LAFVIN_LLM_PROVIDER=claude
# ANTHROPIC_API_KEY=
# LAFVIN_LLM_MODEL=your-claude-model
# LAFVIN_LLM_MAX_TOKENS=1024
# ANTHROPIC_VERSION=2023-06-01

# Custom OpenAI-compatible LLM only
# Set LAFVIN_LLM_PROVIDER above to openai-compatible. All three values below
# are required. Custom ASR and TTS endpoints are intentionally unsupported.
# LAFVIN_LLM_BASE_URL=https://your-llm-service.example/v1
# LAFVIN_LLM_API_KEY=
# LAFVIN_LLM_MODEL=your-llm-model

# Alternative TTS providers
# MiniMax TTS (set LAFVIN_TTS_PROVIDER above to minimax)
# MINIMAX_API_KEY=
# LAFVIN_TTS_MODEL=speech-2.8-turbo
# LAFVIN_TTS_VOICE=English_UpsetGirl

# Fish Audio TTS (set LAFVIN_TTS_PROVIDER above to fish)
# Use the FISH_AUDIO_API_KEY setting in the ASR section above.
# LAFVIN_TTS_MODEL=s2.1-pro-free
# LAFVIN_TTS_VOICE=933563129e564b19a115bedd57b7406a
# FISH_AUDIO_TTS_LATENCY=balanced

# Diagnostics and transient network retries
# LAFVIN_AI_LOG_LEVEL=INFO
# Opt in only while debugging. Logs full LLM replies and the cleaned text sent
# to TTS, which may contain private conversation content.
# Set to 1 to include content in `lafvin-hat app run apps/chatbot --follow`.
# LAFVIN_AI_LOG_CONTENT=0
# LAFVIN_AI_TIMEOUT_SEC=60
# LAFVIN_AI_RETRIES=2
# Capability-specific values override the global timeout and retry settings.
# LAFVIN_ASR_TIMEOUT_SEC=60
# LAFVIN_LLM_TIMEOUT_SEC=60
# LAFVIN_TTS_TIMEOUT_SEC=60
# LAFVIN_ASR_RETRIES=2
# LAFVIN_LLM_RETRIES=2
# LAFVIN_TTS_RETRIES=2

# Optional translator setting
# LAFVIN_TRANSLATOR_TARGET_LANGUAGE=Chinese
